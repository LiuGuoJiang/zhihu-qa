# 知乎内容工作室 - Paperclip 智能体系统
# 环境变量配置示例

# =====================================================
# Claude Code CLI 配置
# =====================================================
# Claude Code CLI 使用本地登录认证，无需 API Key
# 确保已执行: claude login
# 验证登录: claude whoami

# =====================================================
# 知乎账号配置 (必需 - 用于 RPA 登录)
# =====================================================
# 知乎手机号/邮箱
ZHIHU_USERNAME=your_zhihu_username
# 知乎密码
ZHIHU_PASSWORD=your_zhihu_password

# =====================================================
# 浏览器配置
# =====================================================
# 是否使用无头模式 (true/false)
# 生产环境建议 true，首次登录需要设为 false
HEADLESS=true
# 浏览器操作超时时间 (毫秒)
BROWSER_TIMEOUT=30000
# 浏览器用户代理
BROWSER_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36

# =====================================================
# 数据存储路径
# =====================================================
DATA_DIR=./data
SESSIONS_DIR=./data/sessions
QUESTIONS_FILE=./data/questions.json
MATERIALS_DIR=./data/materials
DRAFTS_DIR=./data/drafts

# =====================================================
# RPA 配置
# =====================================================
# 每次获取问题的数量
RPA_QUESTION_LIMIT=20
# 获取回答的最小赞同数
RPA_MIN_VOTES=100
# 搜索结果数量限制
RPA_SEARCH_LIMIT=20

# =====================================================
# 智能体配置
# =====================================================
# 问题探索员心跳间隔 (秒)
QUESTION_SCOUT_INTERVAL=3600
# 每次最多发现的问题数
MAX_QUESTIONS_PER_RUN=10
# 爆款潜力阈值 (0-100)
VIRAL_POTENTIAL_THRESHOLD=60

# 素材研究员配置
MAX_MATERIALS_PER_QUESTION=20
# 素材相关性阈值 (0-1)
MATERIAL_RELEVANCE_THRESHOLD=0.6
# 素材可信度阈值 (0-1)
MATERIAL_CREDIBILITY_THRESHOLD=0.6

# =====================================================
# Paperclip 配置
# =====================================================
# Paperclip 公司配置文件路径
PAPERCLIP_CONFIG=.paperclip/company.yaml
# 智能体定义目录
AGENTS_DIR=agents
# MCP 服务器目录
MCP_SERVERS_DIR=mcp_servers

# =====================================================
# 日志配置
# =====================================================
LOG_LEVEL=INFO
LOG_DIR=./logs
# 日志文件保留天数
LOG_RETENTION_DAYS=7

# =====================================================
# 其他配置
# =====================================================
# 时区
TZ=Asia/Shanghai
# 语言
LANG=zh_CN.UTF-8
