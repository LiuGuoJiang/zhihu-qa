# 知乎问答知识库系统 - 环境变量配置示例

# 知乎相关配置
ZHIHU_COOKIE=your_zhihu_cookie_here
ZHIHU_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Paperclip配置
PAPERCLIP_API_URL=http://localhost:3100
PAPERCLIP_API_KEY=your_paperclip_api_key_here

# OpenAI配置（用于LLM调用）
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# 数据存储路径
DATA_DIR=./data
MATERIALS_DIR=./data/materials
DRAFTS_DIR=./data/drafts

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/zhihu-qa.log

# 问题发现配置
QUESTION_DISCOVERY_INTERVAL=3600  # 每小时执行一次
MAX_QUESTIONS_PER_RUN=10  # 每次最多发现10个问题

# 素材收集配置
MAX_MATERIALS_PER_QUESTION=20  # 每个问题最多收集20个素材
MATERIAL_RELEVANCE_THRESHOLD=0.7  # 素材相关性阈值

# 回答生成配置
MIN_WORD_COUNT=800
MAX_WORD_COUNT=1500
